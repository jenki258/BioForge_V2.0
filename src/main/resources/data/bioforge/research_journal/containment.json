      },
      "line_breaks": 2
    },
    {
      "component": {
        "text": "Airborne reservoirs remain inside connected rooms instead of passing freely through walls and fade over time. Contact strains may persist on mined, touched or walked-on blocks until cleaned.",
        "color": "black"
      },
      "line_breaks": 2
    },
